# ============================================================================
# lolz_reply_bot configuration
# Copy this file to ".env" and fill in the values, or export them as env vars.
# ============================================================================

# --- Required: lolz.live / Zelenka Forum API token (Bearer token) ------------
# Get it from your account settings on https://lolz.live (a token with the
# "read" and "post" scopes is required).
LOLZ_TOKEN=

# --- Which section(s) to work in --------------------------------------------
# ID of the forum/section to leave replies in. You can pass several comma
# separated IDs. This can also be provided on the CLI with --forum-id.
LOLZ_FORUM_ID=

# API base URL (change only if you know what you are doing).
LOLZ_BASE_URL=https://prod-api.lolz.live

# Seconds to wait between API requests (the API allows ~20 req/min).
LOLZ_REQUEST_DELAY=3.0

# --- Optional: LLM for smart, context-aware replies -------------------------
# If an API key is set the bot generates replies with an OpenAI-compatible
# chat completions endpoint. If it is left empty, the bot falls back to the
# built-in template generator (still context aware, based on the title).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Language the replies should be written in (used by both generators).
REPLY_LANGUAGE=ru
